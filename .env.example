# Dhan (data + orders)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Anthropic (powers every agent; NOT needed when JAKAD_RULES_ONLY=1)
ANTHROPIC_API_KEY=

# paper (default, simulated fills, real Dhan data) or live (real Dhan orders)
TRADING_MODE=paper

# Optional overrides
# JAKAD_MODEL=claude-opus-5-5
# ANALYST_MODEL=claude-opus-5-5

# Pure-Python rules mode: no AI agents, no Anthropic key. Same setup, journal, risk gate, trailing stop and BoS adds.
# JAKAD_RULES_ONLY=1

# Optional: block new entries when NIFTY 50 is below its EMA50 (off by default)
# JAKAD_REGIME_FILTER=1

# Stocks to trade. Unset = NSE Nifty 200 (downloaded). Trading symbols or company names, comma separated.
# Owner's starting list:
# JAKAD_SYMBOLS=BSE,SBIN,RELIANCE,AXISCADES,AXISBANK,Maharashtra Seamless
# Seconds between Dhan history requests (default 20)
# JAKAD_DATA_INTERVAL_S=20
